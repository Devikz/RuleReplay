# RuleReplay configuration. This file is safe to commit; copy it to .env for local use.
# Credentials stay on the backend. Never use a VITE_ prefix for secrets.
# API key issued by the official Meta model API provider. Leave empty for local mode.
MODEL_API_KEY=
# Official Meta Model API endpoint, verified 2026-10-29.
MODEL_API_BASE_URL=https://api.meta.ai/v1
# Primary model: Meta Muse Wonder, Standard mode (official identifier).
META_MODEL=muse-wonder-1.0
# Modal account token ID and secret. Leave empty for local-only execution.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Paid integrations require explicit user approval and remain disabled by default.
ALLOW_PAID_MODEL_REQUESTS=false
ALLOW_BILLABLE_MODAL=false
# Conservative local-service budgets; lowering these does not enable paid calls.
MAX_CONCURRENT_ANALYSES=1
MAX_MODEL_CALLS_PER_SESSION=4
MAX_SANDBOXES_PER_SESSION=64
MAX_TESTS_PER_ANALYSIS=48
MAX_SANDBOXES_PER_ANALYSIS=32
MAX_REQUEST_BYTES=256000
MAX_MODEL_RESPONSE_BYTES=256000
MAX_SANDBOX_OUTPUT_BYTES=4096
SANDBOX_TIMEOUT_SECONDS=30
MAX_RECORD_BYTES=2000000
